{
  "name": "@ruihuahe/dsh-agent-codex",
  "version": "0.1.0",
  "description": "Static Codex CLI coding-agent tools for DeepSeek Harness",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hrhgit/dsh-agent-codex.git" },
  "homepage": "https://github.com/hrhgit/dsh-agent-codex#readme",
  "bugs": { "url": "https://github.com/hrhgit/dsh-agent-codex/issues" },
  "keywords": ["deepseek-harness", "dsh", "codex", "agent", "tools"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./catalog": { "types": "./lib/types/catalog.d.ts", "default": "./lib/types/catalog.js" },
    "./persona": { "types": "./lib/types/persona.d.ts", "default": "./lib/types/persona.js" },
    "./exec-command": { "types": "./lib/types/exec-command.d.ts", "default": "./lib/types/exec-command.js" },
    "./write-stdin": { "types": "./lib/types/write-stdin.d.ts", "default": "./lib/types/write-stdin.js" },
    "./apply-patch": { "types": "./lib/types/apply-patch.d.ts", "default": "./lib/types/apply-patch.js" },
    "./view-image": { "types": "./lib/types/view-image.d.ts", "default": "./lib/types/view-image.js" },
    "./update-plan": { "types": "./lib/types/update-plan.d.ts", "default": "./lib/types/update-plan.js" },
    "./request-user-input": { "types": "./lib/types/request-user-input.d.ts", "default": "./lib/types/request-user-input.js" },
    "./request-permissions": { "types": "./lib/types/request-permissions.d.ts", "default": "./lib/types/request-permissions.js" },
    "./spawn-agent": { "types": "./lib/types/spawn-agent.d.ts", "default": "./lib/types/spawn-agent.js" },
    "./list-agents": { "types": "./lib/types/list-agents.d.ts", "default": "./lib/types/list-agents.js" },
    "./send-message": { "types": "./lib/types/send-message.d.ts", "default": "./lib/types/send-message.js" },
    "./interrupt-agent": { "types": "./lib/types/interrupt-agent.d.ts", "default": "./lib/types/interrupt-agent.js" },
    "./list-mcp-resources": { "types": "./lib/types/list-mcp-resources.d.ts", "default": "./lib/types/list-mcp-resources.js" },
    "./list-mcp-resource-templates": { "types": "./lib/types/list-mcp-resource-templates.d.ts", "default": "./lib/types/list-mcp-resource-templates.js" },
    "./read-mcp-resource": { "types": "./lib/types/read-mcp-resource.d.ts", "default": "./lib/types/read-mcp-resource.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.js", "lib/types/**/*.d.ts", "cordis.patch.yml", "README.md", "README.zh-CN.md", "SOURCES.md", "NOTICE", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": { "zh-CN": "Codex 智能体工具", "en": "Codex Agent Tools" },
      "summary": { "zh-CN": "为 Codex 预设提供版本锁定的静态编码工具。", "en": "Version-locked static coding tools for the Codex preset." },
      "category": "productivity"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "clean": "node scripts/clean-package.mjs",
    "contracts": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "typecheck": "pnpm run contracts",
    "test": "pnpm run contracts && vitest run",
    "build": "pnpm run clean && pnpm run contracts",
    "pack:check": "pnpm pack --pack-destination dist",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-shell": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-shell": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-shell-env": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.3",
    "@types/node": "^22.19.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
